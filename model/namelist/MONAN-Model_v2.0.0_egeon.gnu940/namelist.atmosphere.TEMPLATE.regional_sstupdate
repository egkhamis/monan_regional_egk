                                               !(hidden by default)
                                               !Positive real values (default: 0.0)
    config_v_theta_eddy_visc2 = 0.0            ![m^2 s^-1] nabla^2 eddy viscosity for vertical diffusion of theta 
                                               !(hidden by default)
                                               !Positive real values (default: 0.0)
